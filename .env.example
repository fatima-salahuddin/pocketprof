# Copy to .env and fill in. .env is ignored by git; never commit secrets (NFR-10).
ENV=development
PUBLIC_URL=http://localhost:5173
API_URL=http://localhost:8000

# Stores: leave empty in development (SQLite + embedded Qdrant under ./data)
DATABASE_URL=
QDRANT_URL=

# Secrets: generate with  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
PSEUDONYM_KEY=change-me

# Google Classroom (OAuth client of type "Web application"; redirect URI = API_URL + /api/v1/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ENFORCE_ROSTER=false
SYNC_SECONDS=30

# Generation arm. GEN_PROVIDER: auto | anthropic | openai | none
#   Claude:     GEN_PROVIDER=anthropic  GEN_MODEL=claude-opus-5-5  (key in ANTHROPIC_API_KEY or GEN_API_KEY)
#   OpenRouter: GEN_PROVIDER=openai  GEN_BASE_URL=https://openrouter.ai/api/v1  GEN_MODEL=...  GEN_API_KEY=...
#   Ollama:     GEN_PROVIDER=openai  GEN_BASE_URL=http://localhost:11434/v1  GEN_MODEL=qwen2.5:7b-instruct
GEN_PROVIDER=auto
GEN_MODEL=
GEN_BASE_URL=
GEN_API_KEY=
GEN_FALLBACK_MODELS=

# Development seed accounts (python -m pocketprof.seed): admin@, teacher@, student@pocketprof.local
SEED_PASSWORD=pocketprof-dev
